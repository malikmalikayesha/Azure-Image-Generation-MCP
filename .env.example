# Azure Image Generation MCP - Environment Variables Template
# Copy this file to .env and fill in your actual values

# Azure OpenAI API Key (Required)
# Get this from your Azure portal: https://portal.azure.com
AZURE_IMAGE_API_KEY=your_azure_api_key_here

# Azure OpenAI Base URL (Required)
# Format: https://YOUR-RESOURCE-NAME.cognitiveservices.azure.com/openai/deployments
AZURE_IMAGE_BASE_URL=https://your-endpoint.cognitiveservices.azure.com/openai/deployments